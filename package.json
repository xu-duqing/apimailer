{
  "name": "@apimailer/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript and JavaScript SDK for sending email with APIMailer.",
  "keywords": [
    "apimailer",
    "email",
    "mail",
    "transactional-email",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "test": "npm run build && node --test test/client.test.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit --module Node16 --moduleResolution Node16 test/commonjs.typecheck.cts",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
